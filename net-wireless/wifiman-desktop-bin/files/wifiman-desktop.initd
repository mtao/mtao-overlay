description="WiFiman Desktop daemon"
command="/usr/lib/wifiman-desktop/wifiman-desktopd"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
supervisor="supervise-daemon"
respawn_delay=30

depend() {
	need net
}
